# Both values must be set together. Never put service_role or SBIS secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://vxefueynagwuavlyeiqc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OD1Fh_a_qhnjKeMd30RQRA_WgpOXZwq

# Enable only after configuring the phone provider and manual identity linking.
# False means no SMS request or simulated verification is performed.
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false
EXPO_PUBLIC_WAITCALL_ENABLED=false
# Вход через Яндекс ID (провайдер custom:yandex-id в Supabase). Включать после добавления
# sbl://auth/yandex в Supabase -> Authentication -> URL Configuration -> Redirect URLs.
EXPO_PUBLIC_YANDEX_AUTH_ENABLED=false

# Enable in a development/production native build with FCM/APNs credentials.
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false

# Owner will fill and approve these before release; do not invent contacts.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_LEGAL_DOCUMENTS_APPROVED=false

# Public coffee app web URL for share links, when a public deployment exists.
# Without it native builds use sbl://product/<uuid>; web uses its current origin.
EXPO_PUBLIC_APP_WEB_URL=

# Admin-mode login (any phone + any code, no SMS). Keep false/unset for production builds.
EXPO_PUBLIC_ADMIN_LOGIN=false
