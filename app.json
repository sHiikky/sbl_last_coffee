{
  "expo": {
    "name": "SBL",
    "slug": "sbl-coffee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите SBL показать ваше местоположение на карте кофейни.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/brand/splash-full.png",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "barStyle": "light",
          "backgroundColor": "#050505"
        }
      ]
    ],
    "splash": {
      "image": "./assets/brand/splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shikky.sbl"
    },
    "android": {
      "package": "com.shikky.sbl",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#eceae5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/brand/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "00f1af5f-48f9-418b-aa4f-233eead9fd9a"
      }
    },
    "owner": "shikkyy",
    "scheme": "sbl",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#050505"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#050505"
    }
  }
}
